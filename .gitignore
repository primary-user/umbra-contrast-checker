# Test dependencies. The extension itself has none.
test/node_modules/
test/package-lock.json

# The Chrome DevTools port. Handy locally, wrong in a shipped extension, so it
# is never committed.
.debug

# Build output, and Adobe's signing tool once tools/get-zxpsigncmd.sh fetches it.
build/
dist/
tools/bin/

# Anything the panel writes while running.
umbra-loupe.*
umbra-pointer.*
umbra-grab.*

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Signing material. Never commit either of these.
*.zxp
*.p12
